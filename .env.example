# Copy to .env.local and fill in. Never commit real values.

# Anthropic console → Settings → API keys
ANTHROPIC_API_KEY=

# ElevenLabs (voice). Create a key with Text to Speech and Speech to Text access only.
ELEVENLABS_API_KEY=
# Optional: the guide's voice. Defaults to a calm multilingual library voice.
ELEVENLABS_VOICE_ID=

# Signs visitor cookies: any random string of 32+ characters (openssl rand -hex 32)
SESSION_SECRET=

# Supabase (usage limits). Project Settings → Data API → Project URL; API Keys → secret key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional overrides for the free daily limits and the demo's spending ceiling (US dollars).
# FREE_CHAT_PER_DAY=10
# FREE_VOICE_PER_DAY=3
# FREE_COMPARE_PER_DAY=2
# FREE_READ_PER_DAY=10
# VISITOR_DAILY_BUDGET_USD=0.4
# DAILY_BUDGET_USD=3

# Resend (email sign-in codes): an API key with sending access.
RESEND_API_KEY=
# Optional until a domain is verified in Resend; the test sender only delivers to your own address.
# EMAIL_FROM=Divine Dialogue <hello@yourdomain>

# Stripe, TEST mode only: a sandbox secret key (sk_test_...). Live keys are refused
# unless ALLOW_LIVE_PAYMENTS=true.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint's signing secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
