# Copy to .env.local and fill in. Never commit real values.

# Anthropic console → Settings → API keys
ANTHROPIC_API_KEY=

# ElevenLabs (voice). Create a key with Text to Speech and Speech to Text access only.
ELEVENLABS_API_KEY=
# Optional: the guide's voice. Defaults to a calm multilingual library voice.
ELEVENLABS_VOICE_ID=
